<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.opencastproject</groupId>
  <artifactId>quarkus-project-structure-parent</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.version>3.34.3</quarkus.platform.version>
    <maven.compiler-plugin.version>3.15.0</maven.compiler-plugin.version>
    <maven.jandex-plugin.version>3.5.3</maven.jandex-plugin.version>
    <maven.surefire-plugin.version>3.5.5</maven.surefire-plugin.version>
    <jacoco.version>0.8.15</jacoco.version>
    <coverage.reset.skip>false</coverage.reset.skip>
    <htmlunit.version>4.7.0</htmlunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
          <extensions>true</extensions>
          <configuration>
            <warnIfBuildGoalMissing>false</warnIfBuildGoalMissing>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler-plugin.version}</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire-plugin.version}</version>
          <configuration>
            <systemPropertyVariables>
              <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
              <maven.home>${maven.home}</maven.home>
              <!-- `quarkus-jacoco` deletes its data file whenever Quarkus starts, discarding earlier coverage,
                   e.g. from surefire when failsafe starts Quarkus again, or after a restart caused by a `@TestProfile`. -->
              <quarkus.jacoco.reuse-data-file>true</quarkus.jacoco.reuse-data-file>
              <!-- We use `jacoco:report` for the report instead of the extension's own,
                   which is not created at all in modules without any `@QuarkusTest`. -->
              <quarkus.jacoco.report>false</quarkus.jacoco.report>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven.surefire-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
              <configuration>
                <systemPropertyVariables>
                  <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                  <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                  <maven.home>${maven.home}</maven.home>
                  <!-- Both: see surefire above. -->
                  <quarkus.jacoco.reuse-data-file>true</quarkus.jacoco.reuse-data-file>
                  <quarkus.jacoco.report>false</quarkus.jacoco.report>
                </systemPropertyVariables>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>io.smallrye</groupId>
          <artifactId>jandex-maven-plugin</artifactId>
          <version>${maven.jandex-plugin.version}</version>
          <executions>
            <execution>
              <id>make-index</id>
              <goals>
                <goal>jandex</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <executions>
            <execution>
              <id>reset-coverage-data</id>
              <phase>validate</phase>
              <goals>
                <goal>clean</goal>
              </goals>
              <configuration>
                <!-- The data file is kept across Quarkus starts (see `reuse-data-file` below)
                     and appended to, so it would also survive from one build to the next,
                     and stale coverage could hide a gap, e.g. after deleting a test.
                     Deliberately not `maven.clean.skip`: only skip this explicitly,
                     with `-Dcoverage.reset.skip=true`. -->
                <skip>${coverage.reset.skip}</skip>
                <excludeDefaultDirectories>true</excludeDefaultDirectories>
                <filesets>
                  <fileset>
                    <directory>${project.build.directory}</directory>
                    <includes>
                      <include>jacoco-quarkus.exec</include>
                    </includes>
                  </fileset>
                </filesets>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <configuration>
            <!-- All coverage data ends up in this one file, see `prepare-agent` below. -->
            <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
          </configuration>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
              <configuration>
                <!-- Classes loaded by Quarkus (`@QuarkusTest`) are instrumented by the
                     `quarkus-jacoco` extension instead, after Quarkus has transformed them.
                     (The plain agent would instrument them before that, and report 0% for
                     e.g. constructor-injected beans, cf. quarkusio/quarkus#32254.)
                     Both write into the same file, so no merge step is necessary.
                     This is the setup documented in
                     https://quarkus.io/guides/tests-with-coverage
                     Modules not using `quarkus-jacoco` are unaffected;
                     the exclusion simply never matches. -->
                <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
                <append>true</append>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
